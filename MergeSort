#include<stdio.h>
void mergesort(int arr[],int low,int high)
{
    int mid=(high+low)/2;
    if(low==high)return;
    mergesort(arr,low,mid);
    mergesort(arr,mid+1,high);
    merge(arr,low,mid,high);
}
void merge(int arr[],int low,int mid,int high)
{
    int[] temp;
    int left=low;
    int right=mid+1;
    int i=0;
    while(left<mid+1 && right<=high)
    {
        if(arr[left]<=arr[right])
        {
            temp[i]=arr[left];
            i++;
            left++;
        }
        else
        {
            temp[i]=arr[right];
            i++;
            right++;
        }
    }
    while(left<=mid)
    {
        temp[i]=arr[left];
            i++;
            left++;
    }
    while(right<=high)
    {
        temp[i]=arr[right];
            i++;
            right++;
    }
    for(int i=low;i<=high;i++)
    {
        arr[i]=temp[i];
    }
}
