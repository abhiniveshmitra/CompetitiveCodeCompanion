#include<bits/stdc++.h>
using namespace std;
class disjointset{
vector<int> rank,parent;
public:
disjointset(int n){
rank.resize(n+1,0);
parent.resize(n+1);
for(int i=0;i<=n;i++)
parent[i]=i;
}
int findUPar(int node)
{
    if(node==parent[node])
    return node;
    return parent[node]=findUPar(parent[node]);
}
void unionByRank(int u,int v)
{
    int ulp_u=findUPar(u);
    int ulp_v=findUPar(v);
    if(rank[ulp_u]<rank[ulp_v])
    parent[ulp_u]=ulp_v;
    if(rank[ulp_v]<rank[ulp_u])
     parent[ulp_v]=ulp_u;
    else
    {
         parent[ulp_v]=ulp_u;
        rank[ulp_u]++;
    }




    }
};
int main()
{
    disjointset ds(7);
        ds.unionByRank(1,2);
        ds.unionByRank(2,3);
        ds.unionByRank(4,5);
        ds.unionByRank(3,7);
        ds.unionByRank(5,6);
        if(ds.findUPar(7)==ds.findUPar(3))
        {
            cout<<"same";
        }
        else cout<<"not same";
}

