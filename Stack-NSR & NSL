vector<int> nsr( vector<int>& arr, int n) {
    stack<int> st;
    vector<int> ans(n);
    for (int i = n - 1; i >= 0; i--) {
        while (!st.empty() && arr[st.top()] > arr[i])
            st.pop();
        if (st.empty())
            ans[i] = n;
        else
            ans[i] = st.top();
        st.push(i);
    }
    return ans;
}

vector<int> nsl(vector<int>& arr, int n) {
    stack<int> st;
    vector<int> ans(n);
    for (int i = 0; i < n; i++) {
        while (!st.empty() && arr[st.top()] > arr[i])
            st.pop();
        if (st.empty())
            ans[i] = -1;
        else
            ans[i] = st.top();
        st.push(i);
    }
    return ans;
}
