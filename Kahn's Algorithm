vector<int> topologicalSort(vector<vector<int>> &edges, int n)  {
   vector<vector<int>> list=adjlist(edges,n);
   vector<int> indegree(n,0);
   for(auto& it:list)
   {
       for(int& it2:it)
       indegree[it2]++;
   }
   queue<int> q;
   vector<int> ans;
   for(int i=0;i<n;i++)
   if(indegree[i]==0)q.push(i);
   while(!q.empty())
   {
       int node=q.front();
       q.pop();
       ans.push_back(node);
       for(int& it: list[node])
       {
           indegree[it]--;
           if(indegree[it]==0)
           q.push(it);
       }
   }
   return ans;

}
