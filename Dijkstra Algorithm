vector<vector<pair<int,int>>> adjlist(vector<vector<int>>& edges,int n)
{
    vector<vector<pair<int,int>>> list(n);
   for(auto& it :edges)
   {
    int u=it[0];
    int v=it[1];
    int wt=[2];
    list[u].push_back({v,wt});
   }
   return list;

}
void bfs(int source,vector<int>& dist,vector<vector<pair<int,int>>>& list)
{
priority_queue<pair<int,int>, vector<pair<int,int>>, greater<pair<int,int>>> q;
q.push({0,source});
dist[source]=0;
while(!q.empty())
{
    auto& it= q.top();
    int distance=it.first;
    int node=it.second;
    q.pop();
    for(auto& x : list [node])
    {
        if(distance +x.second <dist[x.first])
       {
        dist[x.first]=distance +x.second;
        q.push({dist[x.first],x.first});
       }
    }
}
return ;
}
