vector<vector<pair<lli,lli>>> adjlist(vector<vector<lli>>& edges,lli n)
{
    vector<vector<pair<int,int>>> list(n+1);
   for(auto& it :edges)
   {
    int u=it[0];
    int v=it[1];
    int wt=it[2];
    list[u].push_back({v,wt});
   }
   return list;

}
void bfs(lli source,vector<lli>& dist,vector<vector<pair<lli,lli>>>& list)
{
priority_queue<pair<lli,lli>, vector<pair<lli,lli>>, greater<pair<lli,lli>>> q;
q.push({0,source});
dist[source]=0;
while(!q.empty())
{
    auto& it= q.top();
    auto distance=it.first;
    auto node=it.second;
    q.pop();
    for(auto& x : list [node])
    {
        auto adj_node=x.first;
        auto adj_dist=x.second;
        if(distance +adj_dist <dist[adj_node])
       {
        dist[adj_node]=distance +adj_dist;
        q.push({dist[adj_node],adj_node});
       }
    }
}
return ;
}
