void bfs(ll source,vector<ll>& dist,vector<vector<pair<ll,ll>>>& list)
{
priority_queue<pair<ll,ll>, vector<pair<ll,ll>>, greater<pair<ll,ll>>> q;
q.push({0,source});
dist[source]=0;
while(!q.empty())
{
    auto& it= q.top();
    auto distance=it.first;
    auto node=it.second;
    q.pop();
    if(distance>dist[node])continue;
    for(auto& x : list [node])
    {
        auto adj_node=x.first;
        auto adj_dist=x.second;
        if(distance +adj_dist <dist[adj_node])
       {
        dist[adj_node]=distance +adj_dist;
        q.push({dist[adj_node],adj_node});
       }
    }
}
return ;
}
