class Solution {
  public:
    Node* constructDLL(vector<int>& arr) {
        
        int n=arr.size();
        vector<Node*> dll(n);
        for(int i=0;i<n;i++)
        dll[i]=new Node(arr[i]);
        for(int i=1;i<n;i++)
        dll[i]->prev=dll[i-1];
        for(int i=0;i<n-1;i++)
        dll[i]->next=dll[i+1];
        return dll[0];
    }
};



