vector<ll> rank(n,0),parent(n);
for(ll i=0;i<n;i++)parent[i]=i;
ll find_par(ll u)
{
    if(parent[u]==u)return u;
    return parent[u]=find_par(parent[u]);
}
void unite(ll u,ll v)
{
    u=find_par(u);
    v=find_par(v);
    if(rank[u]!= rank[v])
    {
        if(rank[u]>rank[v])swap(u,v);
        parent[u]=parent[v];
    }
    else
    {
        rank[v]++;
        parent[u]=parent[v];
    }
}

bool same(ll u,ll v)
{
    return find_par(u)==find_par(v);
}
