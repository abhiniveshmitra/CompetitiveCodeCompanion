vector<ll> dsu_rank,parent;
void initialize(ll n)
{
    parent.assign(n,0);
    dsu_rank.assign(n,0);
    for(int i=0;i<n;i++)parent[i]=i;
}

ll find_par(ll u)
{
    if(parent[u]==u)return u;
    return parent[u]=find_par(parent[u]);
}
void unite(ll u,ll v)
{
    u=find_par(u);
    v=find_par(v);
if(u==v)return;
    if(dsu_rank[u]!= dsu_rank[v])
    {
        if(dsu_rank[u]>dsu_rank[v])swap(u,v);
        parent[u]=v;
    }
    else
    {
        dsu_rank[v]++;
        parent[u]=v;
    }
}

bool same(ll u,ll v)
{
    return find_par(u)==find_par(v);
}
