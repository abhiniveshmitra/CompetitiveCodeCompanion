void bfs(lli src,vector<vector<lli>>& list,vector<lli>& vis)
{
    vis[src]=1;
    queue<lli> q;
    q.push(src);
    while(!q.empty())
    {
     auto node=q.front();
     q.pop();
     for(auto& adj:list[node])
     {
        if(vis[adj]==0)
        {
            vis[adj]=1;
            q.push(adj);
        }
     }
    }
}
