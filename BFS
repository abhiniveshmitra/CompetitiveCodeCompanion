void bfs(ll src,vector<vector<ll>>& list,vector<ll>& vis)
{
    vis[src]=1;
    queue<pll> q;
    q.push({src,0});
    while(!q.empty())
    {
     auto node=q.front().ff;
     auto lvl=q.front().ss;
     q.pop();
     for(auto& adj:list[node])
     {
        if(!vis[adj])
        {
            vis[adj]=1;
            q.push({adj,lvl+1});
        }
     }
    }
}
